# Firebase Web App configuration (not service-account credentials)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Never put private AI provider keys in VITE_ variables.
# Configure AI secrets only in trusted server-side environment variables.

# Decart permanent API key (server-side only; never prefix with VITE_)
DECART_API_KEY=

# Flexible AI provider (server-side only; never use VITE_ prefixes)
# Option A: Vercel AI Gateway
AI_GATEWAY_API_KEY=
AI_MODEL=

# Option B: any OpenAI-compatible chat completions endpoint
# Example base URL should end before /chat/completions
AI_API_KEY=
AI_BASE_URL=
# Shared model identifier for either option
# AI_MODEL=
